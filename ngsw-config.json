{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/icon.png",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "location-api",
      "urls": [
        "https://nominatim.openstreetmap.org/*"
      ],
      "version": 1,
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 50,
        "maxAge": "7d",
        "timeout": "10s"
      }
    },
    {
      "name": "quran-api",
      "urls": [
        "https://api.thetaqwatracker.com/quran/*"
      ],
      "version": 1,
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 150,
        "maxAge": "7d",
        "timeout": "10s"
      }
    },
    {
      "name": "hadith-api",
      "urls": [
        "https://api.thetaqwatracker.com/hadith/*"
      ],
      "version": 1,
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 100,
        "maxAge": "7d",
        "timeout": "10s"
      }
    },
    {
      "name": "google-fonts",
      "urls": [
        "https://fonts.googleapis.com/**",
        "https://fonts.gstatic.com/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 20,
        "maxAge": "365d",
        "timeout": "10s"
      }
    },
    {
      "name": "library-pdfs",
      "urls": [
        "https://raw.githubusercontent.com/ezazulhaq/library/master/taqwa_tracker/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 100,
        "maxAge": "30d",
        "timeout": "20s"
      }
    }
  ]
}